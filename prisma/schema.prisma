// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Gender enum
enum Gender {
  MALE
  FEMALE
}

// Submission status enum
enum SubmissionStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

// Submission type enum
enum SubmissionType {
  ROOM
  MEDICINE
  LAB
  PROCEDURE
  OTHER
}

// Pending type enum
enum PendingType {
  AUTHORIZATION_REQUIRED
  DOCUMENTATION_MISSING
  CLARIFICATION_NEEDED
  SYSTEM_ERROR
  INSURANCE_REVIEW
  OTHER
  LML
  CL_KONSUL
  CL_MONITORING_HARIAN
}

model Patient {
  id                   String   @id @default(uuid())
  medicalRecordNumber  String   @unique
  patientName          String
  gender               Gender
  birthDate            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  // Relations
  submissions Submission[]
}

model Room {
  id          String   @id @default(uuid())
  roomNumber  String
  bedNumber   Int?
  roomClass   String   // VIP, GENERAL, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  submissions Submission[]
}

model Payer {
  id        String   @id @default(uuid())
  payerName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  submissions Submission[]
}

model Submission {
  id               String             @id @default(uuid())
  submissionNumber String             @unique
  patientId        String
  roomId           String
  payerId          String
  status           SubmissionStatus   @default(DRAFT)
  submittedAt      DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  // Relations
  patient Patient @relation(fields: [patientId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])
  payer   Payer   @relation(fields: [payerId], references: [id])
  details SubmissionDetail[]
  
  @@map("submissions")
}

model SubmissionDetail {
  id              String            @id @default(uuid())
  submissionId    String
  submissionType  SubmissionType
  pengajuan       String            // Renamed from submissionValue
  note            String?
  status          String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  // Relations
  submission      Submission      @relation(fields: [submissionId], references: [id])
  pendingHistories PendingHistory[]
  
  @@map("submission_details")
}

model PendingHistory {
  id                String   @id @default(uuid())
  submissionDetailId String
  pendingType       String?
  pendingNote       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  resolvedAt        DateTime?
  isActive          Boolean  @default(true)
  
  // Relations
  submissionDetail SubmissionDetail @relation(fields: [submissionDetailId], references: [id])
  
  @@map("pending_histories")
}

model AuditLog {
  id           String   @id @default(uuid())
  moduleName   String   // Patients, Submissions, Pending, etc.
  actionType   String   // CREATE_PATIENT, UPDATE_SUBMISSION, etc.
  referenceId  String?  // ID of the record that was affected
  description  String
  createdBy    String   // User ID or system
  createdAt    DateTime @default(now())
  
  @@map("audit_logs")
}